{"hierarchy":{"paths":[["doc:\/\/org.objecthub.YamlKit\/documentation\/YamlKit"]]},"kind":"article","schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"text":"How YamlKit implements the YAML 1.2.2 processing model and how it can be extended.","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"The YAML specification describes YAML processing as a series of transformations between","type":"text"},{"text":" ","type":"text"},{"text":"three representations (chapter 3). YamlKit implements each of them as a separate,","type":"text"},{"text":" ","type":"text"},{"text":"publicly accessible layer:","type":"text"}]},{"code":["               parse            compose             decode"," YAML text ──────────▶ events ──────────▶ nodes ──────────▶ Swift values","           ◀────────── events ◀────────── nodes ◀────────── Swift values","               emit           serialize             encode"],"type":"codeListing","syntax":null},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Layer"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Types"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Responsibility"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Reader"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Reader"},{"type":"text","text":" (internal)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Encoding detection, line break normalization"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Scanner"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Scanner"},{"type":"text","text":" (internal)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Tokens, indentation, scalar folding and escaping"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Parser"}]}],[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/org.objecthub.YamlKit\/documentation\/YamlKit\/YAMLParser","type":"reference","isActive":true},{"type":"text","text":", "},{"identifier":"doc:\/\/org.objecthub.YamlKit\/documentation\/YamlKit\/YAMLEvent","type":"reference","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Grammar of documents, nodes, and collections"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Composer"}]}],[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/org.objecthub.YamlKit\/documentation\/YamlKit\/YAML","type":"reference","isActive":true},{"type":"text","text":", "},{"identifier":"doc:\/\/org.objecthub.YamlKit\/documentation\/YamlKit\/YAMLNode","type":"reference","isActive":true},{"type":"text","text":", "},{"identifier":"doc:\/\/org.objecthub.YamlKit\/documentation\/YamlKit\/YAMLSchema","type":"reference","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Tag resolution, aliases, key uniqueness, merge keys"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Serializer"}]}],[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/org.objecthub.YamlKit\/documentation\/YamlKit\/YAML","type":"reference","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Implicit tags, quoting, anchors and aliases"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Emitter"}]}],[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/org.objecthub.YamlKit\/documentation\/YamlKit\/YAMLEmitter","type":"reference","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Presentation styles, indentation, line folding"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Codable"}]}],[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/org.objecthub.YamlKit\/documentation\/YamlKit\/YAMLDecoder","type":"reference","isActive":true},{"type":"text","text":", "},{"identifier":"doc:\/\/org.objecthub.YamlKit\/documentation\/YamlKit\/YAMLEncoder","type":"reference","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Mapping between nodes and "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" types"}]}]]],"type":"table"},{"level":3,"text":"Scanner and Parser","anchor":"Scanner-and-Parser","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"The scanner follows the proven design of libyaml: it converts indentation into explicit","type":"text"},{"text":" ","type":"text"},{"text":"block start and end tokens and inserts the tokens of implicit keys retroactively once","type":"text"},{"text":" ","type":"text"},{"text":"the value indicator ","type":"text"},{"code":":","type":"codeVoice"},{"text":" has been found. On top of that design, it implements the rules","type":"text"},{"text":" ","type":"text"},{"text":"that YAML 1.2 tightened compared to YAML 1.1, e.g. restrictions on tabs, the","type":"text"},{"text":" ","type":"text"},{"text":"requirement that block collections start on a new line, multi-line keys in flow","type":"text"},{"text":" ","type":"text"},{"text":"mappings, JSON-like keys followed by adjacent values, and the indentation of flow","type":"text"},{"text":" ","type":"text"},{"text":"content. Every rule is annotated with the production number of the specification.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The parser is a pull-based LL(1) state machine. It never recurses, so the nesting depth","type":"text"},{"text":" ","type":"text"},{"text":"of documents is only limited by the configurable ","type":"text"},{"identifier":"doc:\/\/org.objecthub.YamlKit\/documentation\/YamlKit\/YAML\/ParseOptions\/maximumDepth","isActive":true,"type":"reference"},{"text":".","type":"text"}]},{"level":3,"text":"Composer and Schemas","anchor":"Composer-and-Schemas","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"The composer resolves the tags of untagged nodes using a ","type":"text"},{"identifier":"doc:\/\/org.objecthub.YamlKit\/documentation\/YamlKit\/YAMLSchema","isActive":true,"type":"reference"},{"text":". The three","type":"text"},{"text":" ","type":"text"},{"text":"schemas of the specification are provided; custom schemas, e.g. to interpret the","type":"text"},{"text":" ","type":"text"},{"text":"YAML 1.1 booleans ","type":"text"},{"code":"yes","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"no","type":"codeVoice"},{"text":", can be implemented by conforming to the protocol.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Aliases are replaced by the nodes they refer to. Because ","type":"text"},{"identifier":"doc:\/\/org.objecthub.YamlKit\/documentation\/YamlKit\/YAMLNode","isActive":true,"type":"reference"},{"text":" is a value type,","type":"text"},{"text":" ","type":"text"},{"text":"the copies share their storage. To protect against maliciously crafted documents","type":"text"},{"text":" ","type":"text"},{"text":"(“billion laughs”), the total number of nodes copied by aliases is limited by","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/org.objecthub.YamlKit\/documentation\/YamlKit\/YAML\/ParseOptions\/maximumAliasExpansion","isActive":true,"type":"reference"},{"text":".","type":"text"}]},{"level":3,"text":"Serializer and Emitter","anchor":"Serializer-and-Emitter","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"The serializer decides for every scalar whether its tag can be left implicit: a string","type":"text"},{"text":" ","type":"text"},{"text":"such as ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" must be quoted, while an integer tagged ","type":"text"},{"code":"!!int","type":"codeVoice"},{"text":" can be written in plain","type":"text"},{"text":" ","type":"text"},{"text":"style. The emitter chooses the presentation style of every scalar, honoring the","type":"text"},{"text":" ","type":"text"},{"text":"requested style if the content permits it. It falls back to single-quoted and finally","type":"text"},{"text":" ","type":"text"},{"text":"double-quoted style where necessary.","type":"text"}]},{"level":2,"text":"Conformance Testing","anchor":"Conformance-Testing","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"The package vendors a snapshot of the ","type":"text"},{"identifier":"https:\/\/github.com\/yaml\/yaml-test-suite","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"Tests\/YamlKitTests\/Resources\/yaml-test-suite","type":"codeVoice"},{"text":"; refresh it with","type":"text"},{"text":" ","type":"text"},{"code":"Scripts\/update-yaml-test-suite.sh","type":"codeVoice"},{"text":"). For every test case, the unit tests verify that","type":"text"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"invalid documents are rejected and the events of valid documents match "},{"type":"codeVoice","code":"test.event"},{"type":"text","text":","}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"composed nodes match the expected JSON data in "},{"type":"codeVoice","code":"in.json"},{"type":"text","text":","}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"emitting the parsed events and parsing the result again yields equivalent events, and"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"serializing the composed nodes and parsing the result again yields equal nodes."}]}]}]},{"type":"paragraph","inlineContent":[{"text":"In addition, randomized round-trip tests encode values containing all kinds of special","type":"text"},{"text":" ","type":"text"},{"text":"characters and verify that they are decoded unchanged.","type":"text"}]}]}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/org.objecthub.YamlKit\/documentation\/YamlKit\/Architecture"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yamlkit\/architecture"]}],"metadata":{"title":"Architecture","roleHeading":"Article","modules":[{"name":"YamlKit"}],"role":"article"},"references":{"https://github.com/yaml/yaml-test-suite":{"url":"https:\/\/github.com\/yaml\/yaml-test-suite","titleInlineContent":[{"text":"YAML test suite","type":"text"}],"type":"link","title":"YAML test suite","identifier":"https:\/\/github.com\/yaml\/yaml-test-suite"},"doc://org.objecthub.YamlKit/documentation/YamlKit/YAML/ParseOptions/maximumAliasExpansion":{"url":"\/documentation\/yamlkit\/yaml\/parseoptions\/maximumaliasexpansion","title":"maximumAliasExpansion","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"maximumAliasExpansion"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"}],"identifier":"doc:\/\/org.objecthub.YamlKit\/documentation\/YamlKit\/YAML\/ParseOptions\/maximumAliasExpansion","kind":"symbol","role":"symbol","type":"topic","abstract":[{"text":"The maximum number of nodes that may be copied by resolving aliases","type":"text"},{"text":" ","type":"text"},{"text":"in a single document. This protects against “billion laughs” attacks.","type":"text"}]},"doc://org.objecthub.YamlKit/documentation/YamlKit/YAMLSchema":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"YAMLSchema","kind":"identifier"}],"navigatorTitle":[{"text":"YAMLSchema","kind":"identifier"}],"kind":"symbol","role":"symbol","url":"\/documentation\/yamlkit\/yamlschema","type":"topic","abstract":[{"type":"text","text":"A schema determines how untagged plain scalars are resolved to tags"},{"type":"text","text":" "},{"type":"text","text":"(YAML 1.2.2, chapter 10)."}],"title":"YAMLSchema","identifier":"doc:\/\/org.objecthub.YamlKit\/documentation\/YamlKit\/YAMLSchema"},"doc://org.objecthub.YamlKit/documentation/YamlKit/YAMLEvent":{"title":"YAMLEvent","url":"\/documentation\/yamlkit\/yamlevent","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"YAMLEvent"}],"navigatorTitle":[{"kind":"identifier","text":"YAMLEvent"}],"identifier":"doc:\/\/org.objecthub.YamlKit\/documentation\/YamlKit\/YAMLEvent","kind":"symbol","role":"symbol","type":"topic","abstract":[{"type":"text","text":"An event of the YAML serialization tree (YAML 1.2.2, section 3.1.2)."}]},"doc://org.objecthub.YamlKit/documentation/YamlKit/YAMLParser":{"type":"topic","navigatorTitle":[{"kind":"identifier","text":"YAMLParser"}],"url":"\/documentation\/yamlkit\/yamlparser","kind":"symbol","title":"YAMLParser","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"YAMLParser"}],"identifier":"doc:\/\/org.objecthub.YamlKit\/documentation\/YamlKit\/YAMLParser","abstract":[{"type":"text","text":"A pull parser turning YAML text into a stream of "},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.objecthub.YamlKit\/documentation\/YamlKit\/YAMLEvent"},{"type":"text","text":" values."}]},"doc://org.objecthub.YamlKit/documentation/YamlKit/YAMLEmitter":{"type":"topic","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"YAMLEmitter","kind":"identifier"}],"abstract":[{"text":"Turns a stream of ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/org.objecthub.YamlKit\/documentation\/YamlKit\/YAMLEvent"},{"text":" values into YAML text","type":"text"},{"text":" ","type":"text"},{"text":"(YAML 1.2.2, section 3.1.3 “Present”).","type":"text"}],"url":"\/documentation\/yamlkit\/yamlemitter","navigatorTitle":[{"text":"YAMLEmitter","kind":"identifier"}],"title":"YAMLEmitter","role":"symbol","identifier":"doc:\/\/org.objecthub.YamlKit\/documentation\/YamlKit\/YAMLEmitter"},"doc://org.objecthub.YamlKit/documentation/YamlKit/YAMLEncoder":{"abstract":[{"text":"An object that encodes instances of a data type